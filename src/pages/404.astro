---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout lang="en" title="Page Not Found">
  <section class="section wrap not-found">
    <span class="not-found-emoji">🍕</span>
    <h1>404 — Page not found</h1>
    <p>Looks like this slice went missing. Let's get you back on track.</p>
    <div class="hero-actions" style="justify-content:center;">
      <a class="btn" href="/">Go Home</a>
      <a class="btn btn-outline-dark" href="/menu/">See Menu</a>
    </div>
    <p class="not-found-langs">
      <a href="/">English</a> · <a href="/sv/">Svenska</a> · <a href="/es/">Español</a>
    </p>
  </section>
</BaseLayout>
