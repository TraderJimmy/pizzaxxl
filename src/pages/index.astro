---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationCard from '../components/LocationCard.astro';
import restaurant from '../data/restaurant.json';

const allItems = restaurant.menu.flatMap((cat) => cat.items);
const popular = restaurant.popularItemNumbers
  .map((num) => allItems.find((item) => item.number === num))
  .filter(Boolean);
---

<BaseLayout title="Home" active="home">
  <section class="hero">
    <div class="wrap">
      <div class="hero-content">
        <span class="hero-eyebrow">Swedish Pizza</span>
        <h1>{restaurant.tagline} 🍕</h1>
        <p>{restaurant.intro}</p>
        <div class="hero-actions">
          <a class="btn" href="/menu/">See Menu</a>
          <a class="btn btn-outline" href="/location-hours/">Find Us</a>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/hero-pizza.jpg" alt="Fresh Swedish pizza from PizzaXXL" />
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-title">
      <h2>Popular menu items</h2>
      <p>A few customer favorites from the full menu</p>
    </div>
    <div class="popular-grid">
      {popular.map((item) => item && (
        <div class="popular-card">
          <span class="item-number">{item.number}. {item.name.toUpperCase()}</span>
          <p>{item.description}</p>
          <div class="price">{item.price}</div>
        </div>
      ))}
    </div>
    <div style="text-align:center; margin-top:2rem;">
      <a class="btn" href="/menu/">Full Menu</a>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-title">
      <h2>Our Locations!</h2>
      <p>We are located in two different locations in the Torrevieja area</p>
    </div>
    <div class="locations-grid">
      {restaurant.locations.map((location) => (
        <LocationCard {...location} />
      ))}
    </div>
  </section>
</BaseLayout>
