---
interface Props {
  active?: 'home' | 'menu' | 'location' | 'about';
}
const { active }: Props = Astro.props;
---

<header class="site-header">
  <div class="wrap">
    <a class="logo" href="/">
      <img src="/images/logo.png" alt="PizzaXXL" />
    </a>
    <nav class="site-nav">
      <a href="/" class={active === 'home' ? 'active' : ''}>Home</a>
      <a href="/menu/" class={active === 'menu' ? 'active' : ''}>Menu</a>
      <a href="/location-hours/" class={active === 'location' ? 'active' : ''}>Location & Hours</a>
      <a href="/about/" class={active === 'about' ? 'active' : ''}>About us</a>
    </nav>
  </div>
</header>
