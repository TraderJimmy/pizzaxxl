---
import { t, locales, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  active?: 'home' | 'menu' | 'location' | 'about';
  page?: '' | 'menu/' | 'location-hours/' | 'about/';
}
const { lang, active, page = '' }: Props = Astro.props;
---

<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="logo" href={localePath[lang]}>
      <img src="/images/logo.png" alt="PizzaXXL" />
    </a>
    <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span></span>
      <span></span>
      <span></span>
    </button>
    <nav class="site-nav" id="site-nav" data-nav>
      <a href={localePath[lang]} class={active === 'home' ? 'active' : ''}>{t(lang, 'nav.home')}</a>
      <a href={`${localePath[lang]}menu/`} class={active === 'menu' ? 'active' : ''}>{t(lang, 'nav.menu')}</a>
      <a href={`${localePath[lang]}location-hours/`} class={active === 'location' ? 'active' : ''}>{t(lang, 'nav.location')}</a>
      <a href={`${localePath[lang]}about/`} class={active === 'about' ? 'active' : ''}>{t(lang, 'nav.about')}</a>
      <div class="lang-switch">
        {locales.map((l) => (
          <a
            href={`${localePath[l]}${page}`}
            class={l === lang ? 'lang-active' : ''}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<script>
  function initNavToggle() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!toggle || !nav) return;

    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('is-open');
      toggle.classList.toggle('is-open', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  initNavToggle();
  document.addEventListener('astro:page-load', initNavToggle);
</script>
